# ShopNova Environment Variables (example)
# Copy to .env and fill in real values. Never commit .env.

# Database 

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Payments: Stripe (international)
# Used for hosted Checkout Sessions creation + webhook signature verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payments: PayFast (SA default)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Set to "true" to use the PayFast sandbox endpoint.
PAYFAST_TEST_MODE="true"

# Payments: test gateway (local/dev without real credentials) 
# Optionally override the HMAC secret used to sign test-payment callbacks.
TEST_PAYMENT_SECRET=

# -- Cart persistence: Upstash Redis (production) --
# When BOTH are set, carts are stored in Upstash Redis with a 30-day TTL.
# In development, leaving these unset falls back to the in-memory cart store.
# In production, leaving these unset is a fatal configuration error
# (ShopNova will not silently fall back to an in-memory cart).
# Get them from https://console.upstash.com/redis/<your-db>.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -- Shipping: origin address (optional) --
# The store's dispatch address used as the ORIGIN for every shipping quote.
# Defaults to a Cape Town dispatch point when unset.
SHIPPING_ORIGIN_STREET=
SHIPPING_ORIGIN_CITY="Cape Town"
SHIPPING_ORIGIN_PROVINCE="Western Cape"
SHIPPING_ORIGIN_POSTAL_CODE="8001"
SHIPPING_ORIGIN_COUNTRY="South Africa"

# -- Shipping: live courier credentials --
# When one or more live couriers are configured below, ONLY live couriers
# are queried for quotes (the deterministic MVP provider is NOT used as a
# silent fallback - a failed live quote is never replaced with an arbitrary
# price). When none are configured, the deterministic MVP shipping rule is
# used (free >= R50, flat R5 below).
#
# Bob Go (multi-courier aggregator - the guidebook "multi-courier API")
# is implemented and registered. It is selected only when BOBGO_API_KEY is
# present. Get the API key from the Bob Go portal -> Settings -> API Keys.
# Official API docs: https://api-docs.bob.co.za/bobgo
# Production base URL: https://api.bobgo.co.za/v2
# Sandbox base URL:     https://api.sandbox.bobgo.co.za/v2
# Set BOBGO_TEST_MODE=true to route requests to the sandbox base URL.
BOBGO_API_KEY=
BOBGO_TEST_MODE="true"
#
# Remaining couriers (PENDING - official API contracts/credentials not yet
# wired to an adapter):
# ARAMEX_API_KEY=
# PUDO_API_KEY=
# COURIER_GUY_API_KEY=

# -- Payments: Yoco (SA, hosted Checkout API) --
# Yoco Checkout API (https://payments.yoco.com/api) creates a hosted payment
# page; the outcome is confirmed via a signed Standard Webhooks delivery.
# Both values are server-side only and never reach the browser.
# Get them from the Yoco app -> Sales -> Payment Gateway (test keys first).
YOCO_SECRET_KEY=
# Shared signing secret for webhook signature verification (whsec_...).
YOCO_WEBHOOK_SECRET=

# -- Payments: Stitch (SA, Pay By Bank / EFT / Card via GraphQL) --
# STATUS: PENDING. The hosted-payment-session creation flow uses a GraphQL
# mutation (clientPaymentInitiationRequestCreate) whose exact input contract
# is not available in this environment, so Stitch is NOT selectable yet
# (StitchProvider.isConfigured() returns false). The Svix/Standard Webhooks
# signature verification + OAuth client-credentials token helper are
# implemented and tested; wiring the creation mutation is the remaining work.
# Get credentials from your Stitch integration contact / client onboarding.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# Svix signing secret for webhook signature verification (whsec_...).
STITCH_WEBHOOK_SECRET=

# -- AI: product copy generation (Demo Step 2) --
# The /api/ai/generate-product route uses an LLM to draft a product's title,
# description, tags, suggested price, and category from keywords and/or a
# product photo. Two env vars are checked for the API key, in order:
#   1. OPENAI_API_KEY  (preferred)
#   2. AI_API_KEY      (generic alias)
# When EITHER is set, the route calls an OpenAI-compatible Chat Completions
# API with JSON response mode. The base URL and model are configurable via
# AI_BASE_URL and AI_MODEL so any OpenAI-compatible provider works.
#
# When NEITHER key is set (the default for local demos), the route falls back
# to a deterministic mock generator that returns realistic, instantly-available
# product details without any credentials or network call. This guarantees
# the demo always succeeds offline.
#
# Copy the chosen key + provider settings into .env.local (never committed).
OPENAI_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

#Aramex credentials - Get these from the Aramex developer portal. Until they're set, isConfigured() returns false
ARAMEX_USERNAME=...
ARAMEX_PASSWORD=...
ARAMEX_ACCOUNT_NUMBER=...
ARAMEX_ACCOUNT_PIN=...
ARAMEX_ACCOUNT_ENTITY=...        # e.g. DXB
ARAMEX_ACCOUNT_COUNTRY_CODE=...  # e.g. AE
ARAMEX_TEST_MODE=true